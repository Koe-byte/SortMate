#!/bin/sh
# Reject commit messages that do not follow Conventional Commits.

message_file="$1"
subject=$(head -n 1 "$message_file")

# Let merge, revert, and autosquash commits through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  printf '\nInvalid commit message: %s\n\n' "$subject" >&2
  printf 'Expected: <type>[optional scope]: <description>\n' >&2
  printf 'Example:  feat(bills): split totals across housemates\n\n' >&2
  printf 'Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert\n' >&2
  printf 'See CONTRIBUTING.md for details.\n\n' >&2
  exit 1
fi
